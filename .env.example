RABBITMQ_DEFAULT_USER=platform
RABBITMQ_DEFAULT_PASS=platform
RABBITMQ_URL=amqp://platform:platform@rabbitmq:5672/
QUEUE_NAME=events
EXCHANGE_NAME=events
ROUTING_KEY=events.created
DEAD_LETTER_EXCHANGE=events.dlx
DEAD_LETTER_QUEUE=events.dead
DEAD_LETTER_ROUTING_KEY=events.dead
PROCESS_SECONDS=0.15
MAX_RETRIES=3
